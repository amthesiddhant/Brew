{
  "name": "brew",
  "version": "1.9.0",
  "description": "Brew - Keep your MacBook awake with a fresh cup of coffee",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --mac"
  },
  "author": "Claude AI",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.brew.app",
    "productName": "Brew",
    "asar": true,
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "index.html",
      "gate.html",
      "gate.js",
      "dashboard.html",
      "dashboard.js",
      "stats.js",
      "styles.css",
      "soma-client.js",
      "updater.js",
      "assets/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "icon": "assets/icon.icns",
      "identity": null,
      "target": [
        { "target": "dmg", "arch": "arm64" },
        { "target": "zip", "arch": "arm64" }
      ]
    }
  }
}
